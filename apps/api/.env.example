APP_NAME=Frameloom
APP_ENV=local
APP_KEY=
APP_DEBUG=false  # set true only on your own machine
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local default needs no database server. For Herd or XAMPP use the MySQL block below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=frameloom
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
# With Redis available (docker-compose provides one):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Sign in with Google: the OAuth client id the extension uses.
GOOGLE_CLIENT_ID=

# Billing (Paddle). Leave empty to run without paid plans; admins can still grant plans by hand.
BILLING_PROVIDER=paddle
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_API_BASE=https://api.paddle.com

# Raw telemetry events are deleted after this many days; aggregates are kept.
TELEMETRY_RETENTION_DAYS=30
FRAMELOOM_SIGNUPS_ENABLED=true
